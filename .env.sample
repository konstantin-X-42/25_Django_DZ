# секретный криптографический ключ для подписей (выносить в переменное окружение не загружается в репозиторий)
SECRET_KEY=


# режим отладки (следить за приложением отслеживать ошибки, после внесения изменений перезагружает сервер)
DEBUG=


NAME=      # указываем имя нашей БД postgres
USER=      # указываем пользователя
PASSWORD=  # указываем пароль БД postgres
HOST=      # указываем хост (база данных у нас локально)
PORT=      # указываем порт для подключения базы postgresql
